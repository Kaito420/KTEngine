{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": [
                "debug",
                "/nopause"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": [
                "release",
                "/nopause"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Rebuild (Debug)",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": [
                "debug",
                "rebuild",
                "/nopause"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": [
                "clean",
                "/nopause"
            ],
            "group": "build"
        },
        {
            "label": "Run (Debug)",
            "type": "shell",
            "command": "${workspaceFolder}/run.bat",
            "args": [
                "debug"
            ],
            "problemMatcher": []
        }
    ]
}
